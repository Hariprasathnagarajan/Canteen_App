# ==========================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION
# Set these environment variables in your Render Dashboard:
# Dashboard -> Your Web Service -> Environment -> Add Environment Variables
# ==========================================

# Django Security Key (Generate a random 50+ character string)
SECRET_KEY=django-insecure-replace-this-with-a-very-long-random-string-for-render

# Set to False in Production on Render
DEBUG=False

# Environment flag: 'production' enables SameSite=None & Secure=True cookies for Netlify cross-domain auth
ENVIRONMENT=production

# Allowed Hosts (comma-separated). Note: .onrender.com allows any Render subdomain
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Allowed CORS Origins (comma-separated): Put your Netlify frontend URL here
# Example: https://canteen-portal.netlify.app
CORS_ALLOWED_ORIGINS=https://your-frontend-app.netlify.app,http://localhost:3000,http://localhost:5173

# CSRF Trusted Origins (comma-separated): Include both Netlify URL and your Render URL
# Example: https://canteen-portal.netlify.app,https://canteen-backend.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.netlify.app,https://your-backend-app.onrender.com,http://localhost:3000,http://localhost:5173

# Database URL: If you create a free PostgreSQL on Render, Render sets DATABASE_URL automatically!
# If left blank, Django falls back to SQLite db.sqlite3
DATABASE_URL=

# Cookie security settings (automatically enabled when ENVIRONMENT=production or DEBUG=False)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
