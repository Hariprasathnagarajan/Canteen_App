# ==========================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION
# Set these in your Render Dashboard:
# Dashboard -> canteen-backend Web Service -> Environment -> Add Environment Variable
# ==========================================

SECRET_KEY=your-strong-random-secret-key-here  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=False
ENVIRONMENT=production

# Hosts
ALLOWED_HOSTS=canteen-app-l261.onrender.com,localhost,127.0.0.1,0.0.0.0,.onrender.com

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://vcafe.netlify.app,http://localhost:3000,http://localhost:5173

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://vcafe.netlify.app,https://canteen-app-l261.onrender.com,http://localhost:3000,http://localhost:5173

# Security Settings for Production HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database URL (Render auto-populates this when using Render PostgreSQL)
DATABASE_URL=
